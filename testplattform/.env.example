# Testplattform – lokale Einstellungen (Kopie als .env, nie einchecken)
# Port der Plattform (Standard 8090); sie lauscht nur auf 127.0.0.1
TESTPLATTFORM_PORT=8090
# Optional: Zugangsschlüssel, falls die Plattform nicht nur lokal erreichbar ist (Kopfzeile X-Testplattform-Token)
TESTPLATTFORM_TOKEN=
# Vorlage-API (apis/_vorlage) mit anzeigen
TESTPLATTFORM_VORLAGE=0

# Adressen und API-Keys der APIs. Ohne Angabe: http://127.0.0.1:<Port aus api.json bzw. <NAME>_PORT>,
# API-Key aus apis/<name>/.env (<NAME>_API_KEY).
# ESCOLA_URL=http://127.0.0.1:8080
# ESCOLA_API_KEY=
# CMI_URL=http://127.0.0.1:8082
# CMI_API_KEY=
# SLPLANER_URL=http://127.0.0.1:8081
# SLPLANER_API_KEY=
