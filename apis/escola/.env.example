# Escola-Basis-URL
ESCOLA_BASE_URL=https://www.sekbuelach.ch/

# Anmeldung: bevorzugt über POST /auth/login bzw. die Loginseite /login (mit 2FA).
# Optionaler Fallback ohne Login: kompletter Cookie-Header einer eingeloggten Browser-Sitzung.
ESCOLA_COOKIE=

# Escola schoolUnitId -> Schulhaus
ESCOLA_SCHULEINHEITEN=1:Hinterbirch,2:Mettmenriet

# Wie lange Listen zwischengespeichert werden (Sekunden)
ESCOLA_CACHE_SEKUNDEN=600

# API-Sessions: nach wie vielen Sekunden ohne Aufruf verfallen (Standard 8 h)
ESCOLA_SESSION_LEERLAUF_SEK=28800
# Escola-Session alle N Sekunden aktiv halten (0 = aus)
ESCOLA_KEEPALIVE_SEK=120

# Schutz der eigenen API: jeder Aufruf muss den Header X-API-Key mitsenden. Pflicht, wenn ESCOLA_SCHREIBEN=1.
ESCOLA_API_KEY=

# Schreiben (PATCH /schueler/{id}, /personen/{id}) erlauben: 1 = ja
ESCOLA_SCHREIBEN=0

# Reiter "Gesundheit & Ernährung" lesen/schreiben: 1 = ja (Gesundheitsdaten!)
ESCOLA_GESUNDHEIT=0

# AHV-Nummer, IBAN, BIC im Klartext ausgeben: 1 = ja (Standard: nur "***")
ESCOLA_SENSIBEL_ZEIGEN=0
# Port für start_lokal.py (Standard 8080)
ESCOLA_PORT=8080
# Protokoll im Startfenster: INFO (Standard) oder DEBUG
ESCOLA_LOG=INFO
