# CMI-API – Vorlage für .env (Datei kopieren nach .env, nie einchecken)
# Alle Punkte mit ZU PRÜFEN mit CM Informatik bzw. den CMI-Verantwortlichen klären (README › ZU PRÜFEN).

# --- Verbindung -------------------------------------------------------------
# Basis-URL des CMI-Proxys (Standard https://aadbridge.prod.cmicloud.ch/api/proxy – Proxy-Gruppe ZU PRÜFEN)
CMI_BASE_URL=
# Mandant (Header X-CMI-TENANT-NAME); /tenants zeigt die verfügbaren
CMI_MANDANT=sekbuelach

# Anmeldung über Entra ID (App-Registrierung der Schule; App-only bei CMI ZU PRÜFEN)
CMI_ENTRA_TENANT_ID=
CMI_CLIENT_ID=
# Geheimnis nur hier eintragen, nie ins Repo
CMI_CLIENT_SECRET=
# Standard: api://cmi-proxy-aadbridge-prod-e780cbb4-ae62-8dc7-69cf-46374cd56a34/.default
CMI_SCOPE=
# Alternativ fertiges Zugriffstoken (nur für kurze Tests)
CMI_TOKEN=
CMI_TIMEOUT=60

# TentaQl (ZU PRÜFEN): Vorlage für «Feld = Wert» und Verknüpfung; Suchtext als JSON-String (1) oder Text (0)
CMI_TENTAQL_GLEICH=
CMI_TENTAQL_UND=
CMI_SUCHE_ALS_JSON=1

# --- Schutz -----------------------------------------------------------------
# Jeder Aufruf braucht den Header X-API-Key; Pflicht zum Schreiben
CMI_API_KEY=
# Schreiben in CMI erlauben: 1 = ja
CMI_SCHREIBEN=0
# Zahlungs- und Gesundheitsdaten lesen (besonders schützenswert): 1 = ja, nur mit API-Key
CMI_SCHUETZENSWERT=0

# --- Fachliche Einstellungen des Mandanten (ZU PRÜFEN) ------------------------
# im CMI der Sek Bülach gesehen: «Kontakt mit Adresse» unter Vorlage/Standard/Kontakt (Schreibweise ZU PRÜFEN)
CMI_KONTAKT_VORLAGE=
CMI_KONTAKT_TYP=
# Dossiervorlage (Pfad für ?Vorlage=) und Typname je Art (Typen im CMI der Sek Bülach gesehen, ERKUNDUNG.md)
# gesehen: «Lernendendossier» unter Vorlage/Global/Schulverwaltung (Schreibweise ZU PRÜFEN)
CMI_DOSSIER_SCHUELER_VORLAGE=
CMI_DOSSIER_SCHUELER_TYP=Lernendendossier
CMI_DOSSIER_PERSONAL_VORLAGE=
CMI_DOSSIER_PERSONAL_TYP=Personaldossier
# Personaldossier-Vorlage je Standort (Feld «standort» bei /mitarbeitende), Schreibweise ZU PRÜFEN:
# CMI_DOSSIER_PERSONAL_VORLAGEN=Hinterbirch=Vorlage/Global/Schulverwaltung/Personaldossier Hinterbirch;Mettmenriet=Vorlage/Global/Schulverwaltung/Personaldossier Mettmenriet
CMI_DOSSIER_PERSONAL_VORLAGEN=
CMI_DOSSIER_KLASSE_TYP=Schulklassendossier
# Vorlage Schulklassendossier je Standort (Feld «standort» bei POST /klassen), Schreibweise ZU PRÜFEN
CMI_DOSSIER_KLASSE_VORLAGEN=
# Externes Schulklassendossier (Geschäftseigner muss eine Schuleinheit sein, z. B. «Klassen weitere»)
CMI_DOSSIER_KLASSE_EXTERN_TYP=ExternesSchulklassendossier
CMI_DOSSIER_KLASSE_EXTERN_VORLAGE=
# Offen | Restriktiv
CMI_DOSSIER_ZUGRIFF=Restriktiv
# GUID des Geschäftseigners, falls die Vorlage keinen setzt
CMI_DOSSIER_EIGNER=

# Verknüpfung Kontakt ↔ Dossier (leer = nur über schluesselFremdsystem)
CMI_BETEILIGUNG_ENTITAET=
CMI_BETEILIGUNG_ROLLE=

# Schullaufbahn / Klasseneinteilung (Modell CMI Schule, Entitätsnamen der offiziellen API ZU PRÜFEN)
CMI_SCHULLAUFBAHN_ENTITAET=Schullaufbahn
CMI_KLASSENZUTEILUNG_ENTITAET=KlassenzuteilungLernende
CMI_KLASSENSTUFE_ENTITAET=Teilklasse

# Dokumente: rendition (Datei Base64 beim Anlegen) oder checkin (anlegen, auschecken, einchecken)
CMI_UPLOAD_ART=rendition
CMI_MAX_MB=50
# Zielordner für POST /zeugnisse (Pfad im Lernendendossier)
CMI_ZEUGNIS_ORDNER=b_Dossier Schule/08_Beurteilung
