# Basis-URL der SL-Planer-API (von Seabird AG; ZU PRÜFEN), z. B. https://…/api/v1
SLPLANER_BASE_URL=

# API-Token des SL-Planers – nur hier eintragen, nie ins Repo
SLPLANER_TOKEN=
# Header «Authorization: <Schema> <Token>» (Standard Bearer; ZU PRÜFEN)
SLPLANER_AUTH_SCHEMA=Bearer
# Zeitlimit pro Aufruf in Sekunden
SLPLANER_TIMEOUT=30

# Schutz der eigenen API: jeder Aufruf muss den Header X-API-Key mitsenden. Pflicht für Personaldossier/MAB.
SLPLANER_API_KEY=

# Mitarbeiterbeurteilungen (MAB) und Personaldossier-Dokumente lesen: 1 = ja (besonders schützenswert!)
SLPLANER_PERSONALDOSSIER=0
